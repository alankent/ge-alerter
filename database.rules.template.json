{
  "//": "Template. scripts/gen-rules.mjs writes database.rules.json with __ALLOWED_EMAIL__ replaced from ALLOWED_EMAIL_DOMAINS.",
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid __ALLOWED_EMAIL__",
        ".write": "auth != null && auth.uid == $uid __ALLOWED_EMAIL__",
        "notifications": {
          "//": "The server lists by createdAt (Admin SDK queries still need an index).",
          ".indexOn": [
            "createdAt"
          ]
        },
        "settings": {
          "defaultUrl": {
            ".validate": "newData.isString() && newData.val().length < 2048 && newData.val().matches(/^https?:\\/\\//)"
          }
        },
        "devices": {
          "$device": {
            "token": {
              ".validate": "newData.isString() && newData.val().length < 4096"
            }
          }
        }
      }
    },
    "oauth": {
      ".read": false,
      ".write": false,
      "//": "The server sweeps expired entries by exp.",
      "pending": {
        ".indexOn": [
          "exp"
        ]
      },
      "codes": {
        ".indexOn": [
          "exp"
        ]
      },
      "tokens": {
        ".indexOn": [
          "exp"
        ]
      },
      "refresh": {
        ".indexOn": [
          "exp"
        ]
      }
    }
  }
}
