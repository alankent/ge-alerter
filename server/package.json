{
  "name": "@agent-notifications/server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server + OAuth authorization server that turns Gemini Enterprise tool calls into desktop notifications.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
