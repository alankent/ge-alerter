# Copy to .env for local development (the server reads the real environment on Cloud Run).

# Where this server is reachable from the internet (Cloud Run URL). No trailing slash.
PUBLIC_URL=https://ge-alerter-server-xxxxx-uc.a.run.app
# Where the PWA is hosted (Firebase Hosting URL). No trailing slash.
WEB_URL=https://your-project.web.app

# OAuth client that you enter into Gemini Enterprise. Pick any opaque strings, e.g.
#   OAUTH_CLIENT_ID=$(openssl rand -hex 16)   OAUTH_CLIENT_SECRET=$(openssl rand -base64 32)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Shown on the consent page.
OAUTH_CLIENT_NAME=Gemini Enterprise
# Comma-separated. Gemini Enterprise's redirect is fixed; add http://localhost:... entries for local testing.
OAUTH_REDIRECT_URIS=https://vertexaisearch.cloud.google.com/oauth-redirect

# Comma-separated email domains allowed to connect, e.g. imdigital.com. Empty allows any Google account.
ALLOWED_EMAIL_DOMAINS=

# Token lifetimes.
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=7776000

# firebase (production) or memory (local hacking without a project).
STORE=firebase
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project
# Locally, authenticate the Admin SDK with one of:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# On Cloud Run the service account attached to the service is used automatically.

# Optional: separate secret for signing "Mark done" links (defaults to OAUTH_CLIENT_SECRET).
# ACK_SECRET=
PORT=8080
