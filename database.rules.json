{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "settings": {
          "defaultUrl": { ".validate": "newData.isString() && newData.val().length < 2048 && newData.val().matches(/^https?:\\/\\//)" }
        },
        "devices": {
          "$device": {
            "token": { ".validate": "newData.isString() && newData.val().length < 4096" }
          }
        }
      }
    },
    "oauth": {
      ".read": false,
      ".write": false
    }
  }
}
